# Required for SEC EDGAR requests. SEC requires an identifying User-Agent.
SEC_EDGAR_IDENTITY="Your Name your.email@example.com"

# Optional: enables FINRA's credentialed Query API. Not needed for offline tests.
FINRA_CLIENT_ID="your_finra_client_id"
FINRA_CLIENT_SECRET="your_finra_client_secret"

# Testing only: use FINRA mock datasets rather than production datasets.
# FINRA_USE_MOCK="false"

# Optional: enables the read-only Robinhood MCP integration (broker tools).
# OAuth credentials are stored locally at ~/.stockbot/robinhood/oauth.json
# with restrictive permissions.
BROKER_ENABLED="false"
# OAuth is pinned to https://agent.robinhood.com/mcp/trading.

# Optional: enables external web research via the search_web tool. Exa
# results are research evidence, never canonical financial records.
# Offline tests do not need this.
EXA_ENABLED="false"
EXA_API_KEY="your_exa_api_key"
# Required for live JEV decisions, including decision/ experiments.
# Offline checks do not need these values. Tests inject fake values.
# JEV calls one configured decision endpoint.
# Set these four values to select the protocol, provider, and model. No code change is necessary.
# The code supplies no format, URL, or model default. A live call fails when a value is blank.
# DECISION_API_FORMAT: required. Use "chat_completions" or "decisions".
#   A missing, blank, or unsupported value fails before any HTTP request.
#   Stockbot never infers the format from the key, model, host, or URL path.
# DECISION_API_URL: the full endpoint URL. Stockbot posts to it verbatim and appends no path.
# DECISION_API_KEY: the credential. Stockbot sends "Authorization: Bearer <key>".
#   Never commit a populated key.
# DECISION_MODEL: the one model for every existing JEV operation, such as entry
#   routing, tool selection, result assessment, and adjudication.
# chat_completions: an OpenAI-compatible Chat Completions endpoint.
#   Example URL shape: "https://<provider-host>/v1/chat/completions".
#   The body contains model, messages, and stream=false.
#   The response must have choices[0].message.content as a string with a JSON object.
#   Stockbot does not require tools, response_format, JSON Schema, or logprobs.
#   The model reports its own probabilities. These values are model estimates,
#   not calibrated measurements.
# decisions: a native Decisions API endpoint.
#   The body is exactly model, state, and questions. It has no messages or stream.
#   The response has top-level answers, model, and usage objects.
#   Stockbot keeps the provider's probabilities and score legend unchanged.
#   Example for the OpenRouter model "typesafe/jev-1.13":
#     DECISION_API_FORMAT="decisions"
#     DECISION_API_URL="https://openrouter.ai/api/alpha/decisions"
#     DECISION_MODEL="typesafe/jev-1.13"
#   This example is not a code default.
# Stockbot validates the answers strictly. It makes no retry and uses no fallback model.
# The existing decision thresholds stay unchanged.
# See docs/runtime.md "JEV decision API".
DECISION_API_FORMAT=""
DECISION_API_URL=""
DECISION_API_KEY=""
DECISION_MODEL=""

# OpenCode settings for the Reasoner and other non-JEV model calls. JEV does not use them.
# Local decision/ prompt-chain experiments can read these from a local .env via Bun.
# These are NOT sandbox credentials: Docker-managed Opencode auth remains proxy-managed.
OPENCODE_API_KEY=""
OPENCODE_URL="https://opencode.ai/zen/go/v1/responses"
OPENCODE_MODEL="muse-spark-1.3-contributor"

# Optional: SQLite path for run/event/tool/model logs (default: data/runs.sqlite).
# RUNS_DB_PATH="data/runs.sqlite"

# Optional: Google public-data research (off by default). Unset keys only
# disable Google sources; SEC/FINRA startup never needs them.
GOOGLE_DATA_ENABLED="false"
GOOGLE_CLOUD_PROJECT=""
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/billing-disabled-project-key.json"
# GOOGLE_CLOUD_API_KEY is the shared Cloud key for YouTube Data v3 only.
# DATACOMMONS_API_KEY is the separate Data Commons key.
# BigQuery uses ADC plus GOOGLE_CLOUD_PROJECT and never an API key.
DATACOMMONS_API_KEY=""
GOOGLE_CLOUD_API_KEY=""
# Byte caps for the bounded BigQuery executor (defaults shown).
BIGQUERY_MAX_BYTES_PER_QUERY="1073741824"
BIGQUERY_DAILY_BYTES_LIMIT="10737418240"
BIGQUERY_MONTHLY_BYTES_LIMIT="536870912000"
# Daily YouTube search reservation cap (default shown).
YOUTUBE_SEARCH_DAILY_LIMIT="80"
# Official Trends API stays disabled pending alpha approval.
GOOGLE_TRENDS_API_ENABLED="false"

# Stockbot default: opencode-go / muse-spark-1.3-contributor (host auth entry `opencode-go`).
STOCKBOT_PROVIDER="opencode-go"
STOCKBOT_MODEL="muse-spark-1.3-contributor"
# Local alternative (flag override only, no auth mount):
# STOCKBOT_PROVIDER="granite-local"
# STOCKBOT_MODEL="lmstudio-community/granite-4.1-8b-GGUF:Q4_K_M"
# Sandbox credentials stay out of this file: Docker-managed Opencode auth is proxy-managed
# (see sandbox/stockbot/HOST_SETUP.md); local non-sandbox runs take those from the shell.
# Exception: OPENCODE_API_KEY above serves local decision/ reasoning experiments and the
# Needle harness on the developer host only. Never commit a populated key. Do not set PI_AGENT_DIR here.
# Local models: host models.json baseUrl must be container-reachable — http://localhost:... fails inside Docker; use http://host.docker.internal:... or a LAN URL.

# Needle Harness (single root .env; loaded by needle-harness/scripts/needle.ts)
# Uses OPENCODE_API_KEY above (shared with decision/ reasoning experiments).
BENCHMARK="0"
NEEDLE_WEIGHTS="../needle3.cact"
NEEDLE_CONFIDENCE_FLOOR="0.5"
# CONFIDENCE_FLOOR="0.5" # optional, wins over NEEDLE_CONFIDENCE_FLOOR
PORT="3000"
# STOCKBOT_DEBUG=1 streams unfiltered working logs in the UI (routing
# decisions, tool args, model, tokens). Unset/false summarizes like prod.
STOCKBOT_DEBUG="0"
