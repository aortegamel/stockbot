{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "decision/run.ts",
        "decision/**/*.test.ts",
        "decision/runtime.ts"
      ],
      "project": ["decision/**/*.ts"],
      "stryker": {
        "config": ["stryker.conf.json"]
      },
      "ignoreBinaries": [
        "uv",
        "poly-crap",
        "gitleaks",
        "osv-scanner",
        "llama-server"
      ]
    },
    "needle-harness": {
      "entry": ["scripts/needle.ts"],
      "project": ["**/*.{js,ts,tsx}"]
    },
    "web": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,css}"]
    }
  }
}
