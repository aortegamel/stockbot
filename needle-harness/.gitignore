# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

next-env.d.ts

# local benchmark output (never committed; keep the dir)
/benchmarks/*.json
# generated at warmup via tool_bridge describe (never committed)
/.needle-catalog.json
# tsc incremental build info (never committed)
tsconfig.tsbuildinfo
# bun coverage output (never committed)
/coverage-ts/
/coverage-harness/
# packaged PDF.js assets copied at dev/build time (never committed)
/public/pdfjs/
